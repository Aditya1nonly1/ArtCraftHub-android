<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- installing and removing ArtCraft apps; Android asks the user each time -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android 11+ hides other apps unless declared: the ArtCraft apps, plus launchable apps so
         repos added later (not in this list) can still be found. -->
    <queries>
        <package android:name="io.github.artcraftandroid.procraft" />
        <package android:name="io.github.artcraftandroid.pdfcraft" />
        <package android:name="io.github.artcraftandroid.lightcraft" />
        <package android:name="io.github.artcraftandroid.gridcraft" />
        <package android:name="io.github.artcraftandroid.wordcraft" />
        <package android:name="io.github.artcraftandroid.capcraft" />
        <package android:name="io.github.artcraftandroid.filmcraft" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hub">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".system.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
